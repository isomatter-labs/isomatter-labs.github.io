cabal-version:       2.2

name:                isomatter-labs
version:             0.1.0.0
-- synopsis:
-- description:
homepage:            https://isomatter-labs.com
license:             BSD-3-Clause
license-file:        LICENSE
author:              M Cooper Healy
maintainer:          m.cooper.healy@gmail.com
copyright:           2026 Isomatter::Labs
category:            Web
build-type:          Simple
extra-source-files:  README.md
                     CHANGELOG.md

executable isomatter-labs
  main-is:             site.hs
  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5,
                       hakyll
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-record-updates
                       -Wincomplete-uni-patterns
                       -Wmissing-export-lists
                       -Wmissing-home-modules
                       -Wpartial-fields
                       -Wredundant-constraints
                       -threaded
